# ── Database (Neon PostgreSQL for production) ──────────────────────────────
# Get this from https://neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="generate-a-long-random-string"

# ── Admin account (created on first setup) ─────────────────────────────────
ADMIN_EMAIL="your@email.com"
ADMIN_PASSWORD="choose-a-strong-password"

# ── Vercel Blob (file storage for uploads) ──────────────────────────────────
# Created automatically by Vercel when you add a Blob store
# For local dev with blob: run `vercel env pull` after linking the project
BLOB_READ_WRITE_TOKEN=""
